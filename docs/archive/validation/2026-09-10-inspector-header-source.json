{"ok":true,"data":{"sourceId":"wow-ui-source","product":"retail","requestedRef":"latest","matchedTag":null,"resolvedCommit":"8ea15b61e45c0ed4eba01439c90757f86eb78d34","snapshotId":"wow-ui-source-retail-8ea15b61e45c0ed4eba01439c90757f86eb78d34","results":[{"kind":"function","name":"SecureGroupHeader_Update","path":"Interface/AddOns/Blizzard_RestrictedAddOnEnvironment/SecureGroupHeaders.lua","matchedBy":"exact_symbol","role":"project","excerpt":"394: function SecureGroupHeader_Update(self)\n395: \tlocal nameList = self:GetAttribute(\"nameList\");\n396: \tlocal groupFilter = self:GetAttribute(\"groupFilter\");\n397: \tlocal roleFilter = self:GetAttribute(\"roleFilter\");\n398: \tlocal sortMethod = self:GetAttribute(\"sortMethod\");\n399: \tlocal groupBy = self:GetAttribute(\"groupBy\");\n400: \n401: \twipe(sortingTable);\n402: \n403: \t-- See if this header should be shown\n404: \tlocal kind, start, stop = GetGroupHeaderType(self);\n405: \tif ( not kind ) then\n406: \t\tconfigureChildren(self, sortingTable);\n407: \t\treturn;\n408: \tend\n409: \n410: \tif ( not groupFilter and not roleFilter and not nameList ) then\n411: \t\tgroupFilter = \"1,2,3,4,5,6,7,8\";\n412: \tend\n413: \n414: \tif ( groupFilter or roleFilter ) then\n415: \t\tlocal strictFiltering = self:GetAttribute(\"strictFiltering\"); -- non-strict by default\n416: \t\twipe(tokenTable)\n417: \t\tif ( groupFilter and not roleFilter ) then\n418: \t\t\t-- filtering by a list of group numbers and/or classes\n419: \t\t\tfillTable(tokenTable, strsplit(\",\", groupFilter));\n420: \t\t\tif ( strictFiltering ) then\n421: \t\t\t\tfillTable(tokenTable, \"MAINTANK\", \"MAINASSIST\", \"TANK\", \"HEALER\", \"DAMAGER\", \"NONE\")\n422: \t\t\tend\n423: \n424: \t\telseif ( roleFilter and not groupFilter ) then\n425: \t\t\t-- filtering by role (of either type)\n426: \t\t\tfillTable(tokenTable, strsplit(\",\", roleFilter));\n427: \t\t\tif ( strictFiltering ) then\n428: \t\t\t\tfillTable(tokenTable, 1, 2, 3, 4, 5, 6, 7, 8, unpack(CLASS_SORT_ORDER))\n429: \t\t\tend\n430: \n431: \t\telse\n432: \t\t\t-- filtering by group, class and/or role\n433: \t\t\tfillTable(tokenTable, strsplit(\",\", groupFilter));\n434: \t\t\tfillTable(tokenTable, strsplit(\",\", roleFilter));\n435: \n436: \t\tend\n437: \n438: \t\tfor i = start, stop, 1 do\n439: \t\t\tlocal unit, name, subgroup, className, role, assignedRole = GetGroupRosterInfo(kind, i);\n440: \n441: \t\t\tif ( name and\n442: \t\t\t\t((not strictFiltering) and\n443: \t\t\t\t\t( tokenTable[subgroup] or tokenTable[className] or (role and tokenTable[role]) or tokenTable[assignedRole] ) -- non-strict filtering\n444: \t\t\t\t) or\n445: \t\t\t\t\t( tokenTable[subgroup] and tokenTable[className] and ((role and tokenTable[role]) or tokenTable[assignedRole]) ) -- strict filtering\n446: \t\t\t) then\n447: \t\t\t\ttinsert(sortingTable, unit);\n448: \t\t\t\tsortingTable[unit] = name;\n449: \t\t\t\tif ( groupBy == \"GROUP\" ) then\n450: \t\t\t\t\tgroupingTable[unit] = subgroup;\n451: \n452: \t\t\t\telseif ( groupBy == \"CLASS\" ) then\n453: \t\t\t\t\tgroupingTable[unit] = className;\n454: \n455: \t\t\t\telseif ( groupBy == \"ROLE\" ) then\n456: \t\t\t\t\tgroupingTable[unit] = role;\n457: \n458: \t\t\t\telseif ( groupBy == \"ASSIGNEDROLE\" ) then\n459: \t\t\t\t\tgroupingTable[unit] = assignedRole;\n460: \n461: \t\t\t\tend\n462: \t\t\tend\n463: \t\tend\n464: \n465: \t\tif ( groupBy ) then\n466: \t\t\tlocal groupingOrder = self:GetAttribute(\"groupingOrder\");\n467: \t\t\tdoubleFillTable(wipe(tokenTable), strsplit(\",\", groupingOrder:gsub(\"%s+\", \"\")));\n468: \t\t\tif ( sortMethod == \"NAME\" ) then\n469: \t\t\t\ttable.sort(sortingTable, sortOnGroupWithNames);\n470: \t\t\telse\n471: \t\t\t\ttable.sort(sortingTable, sortOnGroupWithIDs);\n472: \t\t\tend\n473: \t\telseif ( sortMethod == \"NAME\" ) then -- sort by ID by default","contentHash":"22db9615ad4a8d619bd1e730b8c322a93d414a579aa67d64cfda002de2f0fecc","line":394,"score":100,"scoreParts":{"match":100,"rolePena