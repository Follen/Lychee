        "excerpt": "835: function AddonTooltip_Update(owner)\n836: \tlocal id = owner:GetID();\n837: \tlocal name = C_AddOns.GetAddOnName(id);\n838: \tlocal title = C_AddOns.GetAddOnTitle(id);\n839: \tlocal notes = C_AddOns.GetAddOnNotes(id);\n840: \tlocal security = C_AddOns.GetAddOnSecurity(id);\n841: \tAddonTooltip:ClearLines();\n842: \tif ( security == \"BANNED\" ) then\n843: \t\tAddonTooltip:SetText(ADDON_BANNED_TOOLTIP);\n844: \telse\n845: \t\tlocal tooltipTitle = title or name;\n846: \t\tlocal version = C_AddOns.GetAddOnMetadata(id, \"Version\");\n847: \t\tAddonTooltip:AddDoubleLine(tooltipTitle, version);\n848: \t\tAddonTooltip:AddLine(notes, 1.0, 1.0, 1.0, true);\n849: \t\tGameTooltip_AddColoredLine(AddonTooltip, AddonTooltip_BuildDeps(C_AddOns.GetAddOnDependencies(id)), NORMAL_FONT_COLOR, true);\n850: \tend\n851: \tif ADDON_ACTIONS_BLOCKED[name] then\n852: \t\tAddonTooltip:AddLine(INTERFACE_ACTION_BLOCKED_TOOLTIP:format(ADDON_ACTIONS_BLOCKED[name]));\n853: \tend\n854: \n855: \tlocal loaded = C_AddOns.IsAddOnLoaded(name);\n856: \tif loaded and C_AddOnProfiler.IsEnabled() and not InGlue() then\n857: \t\tGameTooltip_AddBlankLineToTooltip(AddonTooltip);\n858: \n859: \t\tAddonTooltip_AddAddonMetric(AddonTooltip, name, ADDON_LIST_PERFORMANCE_AVERAGE_CPU, Enum.AddOnProfilerMetric.SessionAverageTime);\n860: \n861: \t\tlocal showWarningOnly = true;\n862: \t\tAddonTooltip_AddAddonMetric(AddonTooltip, name, ADDON_LIST_PERFORMANCE_CURRENT_CPU, Enum.AddOnProfilerMetric.RecentAverageTime, showWarningOnly);\n863: \t\tAddonTooltip_AddAddonMetric(AddonTooltip, name, ADDON_LIST_PERFORMANCE_PEAK_CPU, Enum.AddOnProfilerMetric.PeakTime, showWarningOnly);\n864: \t\tAddonTooltip_AddAddonMetric(AddonTooltip, name, ADDON_LIST_PERFORMANCE_ENCOUNTER_CPU, Enum.AddOnProfilerMetric.EncounterAverageTime, showWarningOnly);\n865: \n866: \t\tlocal mem = GetAddOnMemoryUsage(name);\n867: \t\tif mem > 0 then\n868: \t\t\tif mem > 1024 then\n869: \t\t\t\tGameTooltip_AddColoredLine(AddonTooltip, ADDON_LIST_PERFORMANCE_MEMORY_MB:format(mem / 1024), WHITE_FONT_COLOR);\n870: \t\t\telse\n871: \t\t\t\tGameTooltip_AddColoredLine(AddonTooltip, ADDON_LIST_PERFORMANCE_MEMORY_KB:format(mem), WHITE_FONT_COLOR);\n872: \t\t\tend\n873: \t\tend\n874: \tend\n875: \n876: \tAddonTooltip:Show()\n877: end",
